<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio Files</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>CFBundleName</key>
	<string>Osier</string>
	<key>CFBundleDisplayName</key>
	<string>Osier</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Osier needs microphone access to record audio for transcription.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>Osier needs accessibility access to provide system-wide functionality.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Osier reads the active browser tab's URL to record where a dictation happened and to apply per-site model rules.</string>
	<!-- No SUFeedURL on purpose. Osier is a hard fork and has no appcast of its own yet;
	     the key used to hold my-monkeys' feed, which meant the "Check for Updates…" menu
	     item (a live manual trigger, regardless of SUEnableAutomaticChecks) would fetch
	     upstream's appcast and offer their DMG — signed with the SUPublicEDKey below, so
	     it would even verify. With no feed key, Sparkle has nothing to fetch.
	     SUPublicEDKey is now Osier's own (generated with Sparkle 2.9.4 bin/generate_keys;
	     the private half lives in Sara's login keychain). It stays inert until a feed is
	     set — see docs/RELEASING.md before adding SUFeedURL. -->
	<key>SUPublicEDKey</key>
	<string>e90KkxchnYkL3XMEws2sp3TvOLxThyUV1g2Ww1CfaK8=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The Remote engine points at ANY user-specified OpenAI-compatible server,
		     commonly a self-hosted endpoint reached over plain HTTP at an arbitrary
		     hostname (e.g. http://litellm.docker.lan, http://ollama.box:11434). Since
		     the host is whatever the user types, ATS must be disabled wholesale.
		     IMPORTANT: NSAllowsArbitraryLoads must stand ALONE here. On macOS 10.12+
		     the presence of NSAllowsLocalNetworking (or the other granular keys) makes
		     the system IGNORE NSAllowsArbitraryLoads, which re-blocks cleartext HTTP to
		     non-.local hostnames like *.docker.lan. Cloud presets (Groq) are HTTPS. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Osier connects to remote transcription servers on your local network (e.g. a self-hosted Whisper/LiteLLM endpoint).</string>
</dict>
</plist>
